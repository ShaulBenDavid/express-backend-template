generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  picture      String?
  googleId     String?  @unique
  roles        Role[]   @default([USER])
  tokenVersion Int      @default(0)
  books        Book[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Book {
  id            String   @id @default(cuid())
  title         String
  author        String
  description   String?
  publishedYear Int?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("books")
}
